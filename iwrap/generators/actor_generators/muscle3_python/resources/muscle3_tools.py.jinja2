# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#                                   INIT MUSCLE3
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
def init_muscle3():

    input_ports = []
    output_ports = []

    # # # # - - - INPUT ('F_INIT') ports  - - - # # # #
{% for argument in code_description.implementation.subroutines.main.arguments  if argument.intent == 'IN' %}
    # {{ argument.name }}
    input_ports.append("{{ argument.name }}")

{% endfor %}
    # # # # - - - OUTPUT ('O_F') ports  - - - # # # #
{% for argument in code_description.implementation.subroutines.main.arguments  if argument.intent == 'OUT' %}
    # {{ argument.name }}
    output_ports.append("{{ argument.name }}")

    {% endfor %}
    ports = {ymmsl.Operator.F_INIT : input_ports, ymmsl.Operator.O_F : output_ports}
{% if flags.checkpointable %}
    m3_instance = libmuscle.Instance(ports, libmuscle.USES_CHECKPOINT_API)
{%  else %}
    m3_instance = libmuscle.Instance(ports)
{%  endif %}

    return m3_instance


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
