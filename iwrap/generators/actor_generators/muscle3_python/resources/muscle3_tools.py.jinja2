#                                   RESTORING CODE STATE
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
{% if flags.checkpointable  %}
def receive_code_state(m3_instance: libmuscle.Instance):
    m3_message = m3_instance.load_snapshot()
    if m3_message is None:
        return None

    return m3_message.data

def save_code_state(m3_instance: libmuscle.Instance, state_str):

    timestamp = -1.0
    m3_message = libmuscle.Message( timestamp, None, state_str)
    m3_instance.save_final_snapshot(m3_message)

