// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
void send_ids(libmuscle::Instance* m3_instance, std::string argument_name, IdsNs::Ids* ids, double timestamp)
{
    std::string ids_str;

    ids_str = ids->serialize(DEFAULT_SERIALIZER_PROTOCOL);
    auto ids_bytes = libmuscle::Data::byte_array(ids_str.data(), ids_str.size());
    libmuscle::Message msg( timestamp, ids_bytes);

    m3_instance->send(argument_name, msg);
}


