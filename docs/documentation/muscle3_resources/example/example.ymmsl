ymmsl_version: v0.1

model:
  name: example
  components:
    macro: macro
    micro: micro
  conduits:
    macro.core_profiles_out: micro.core_profiles_in
    micro.distribution_sources_out: macro.distribution_sources_in
settings:
  t_max: 2.0
  dt: 1.0
  muscle_remote_log_level: DEBUG

implementations:
  micro:
    executable: ${IWRAP_ACTORS_DIR}/m3_actor/bin/m3_actor.exe

  macro:
    executable: ${EXAMPLE_DIR}/macro.exe

resources:
  macro:
    threads: 1

  micro:
    threads: 1


